generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  studentId    String?
  role         String   @default("STUDENT") // STUDENT | FACULTY | ADMIN
  department   String?
  year         Int?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eventsOrganized     Event[]              @relation("EventOrganizer")
  rsvps               EventRsvp[]
  lostItems           LostItem[]
  foundItems          FoundItem[]
  roommateProfile     RoommateProfile?
  sentConnections     RoommateConnection[] @relation("SentConnections")
  receivedConnections RoommateConnection[] @relation("ReceivedConnections")
  notifications       Notification[]
  aiConversations     AiConversation[]
  feedbacks           Feedback[]
}

model CampusLocation {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  category     String // ACADEMIC | LAB | LIBRARY | CAFETERIA | HOSTEL | SPORTS | MEDICAL | ADMIN | FACILITY
  lat          Float
  lng          Float
  floor        String?
  description  String
  openingHours String
  isAccessible Boolean  @default(true)
  amenities    String? // JSON string of amenities
  buildingId   String?
  imageUrl     String?
  createdAt    DateTime @default(now())

  events Event[]
}

model Building {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  lat         Float
  lng         Float
  floors      Int      @default(3)
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Facility {
  id           String   @id @default(uuid())
  name         String
  category     String // COMPUTER_LAB | PRINTING | ATM | AUDITORIUM | FIRST_AID | STUDY_ROOM
  buildingName String
  roomNumber   String
  floor        String
  description  String
  openingHours String
  isAccessible Boolean  @default(true)
  lat          Float
  lng          Float
  createdAt    DateTime @default(now())
}

model Event {
  id               String   @id @default(uuid())
  title            String
  description      String
  category         String // TECHNICAL | CULTURAL | SPORTS | WORKSHOPS | HACKATHONS | SEMINARS | CLUBS | COMPETITIONS | PLACEMENT | ACADEMIC
  date             String // YYYY-MM-DD
  startTime        String // HH:mm
  endTime          String // HH:mm
  locationName     String
  locationId       String?
  organizerName    String
  organizerId      String?
  imageUrl         String?
  maxParticipants  Int      @default(100)
  isFree           Boolean  @default(true)
  registrationLink String?
  createdAt        DateTime @default(now())

  location  CampusLocation? @relation(fields: [locationId], references: [id])
  organizer User?           @relation("EventOrganizer", fields: [organizerId], references: [id])
  rsvps     EventRsvp[]
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("REGISTERED") // REGISTERED | ATTENDED | CANCELLED
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model LostItem {
  id                String   @id @default(uuid())
  userId            String
  title             String
  category          String // ELECTRONICS | ID_CARDS | WALLETS_BAGS | BOOKS_STATIONERY | KEYS | ACCESSORIES | OTHER
  description       String
  color             String
  lostDate          String // YYYY-MM-DD
  locationName      String
  imageUrl          String?
  contactPreference String   @default("IN_APP") // IN_APP | EMAIL
  status            String   @default("ACTIVE") // ACTIVE | RESOLVED
  createdAt         DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches ItemMatch[] @relation("LostItemMatches")
}

model FoundItem {
  id            String   @id @default(uuid())
  userId        String
  title         String
  category      String // ELECTRONICS | ID_CARDS | WALLETS_BAGS | BOOKS_STATIONERY | KEYS | ACCESSORIES | OTHER
  description   String
  color         String
  foundDate     String // YYYY-MM-DD
  locationName  String
  imageUrl      String?
  contactMethod String   @default("CAMPUS_SECURITY_DESK")
  status        String   @default("ACTIVE") // ACTIVE | CLAIMED
  createdAt     DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches ItemMatch[] @relation("FoundItemMatches")
}

model ItemMatch {
  id              String   @id @default(uuid())
  lostItemId      String
  foundItemId     String
  confidenceScore Int // 0 - 100 percentage
  matchReason     String
  status          String   @default("PENDING") // PENDING | CONFIRMED | DISMISSED
  createdAt       DateTime @default(now())

  lostItem  LostItem  @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem FoundItem @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)
}

model Cafeteria {
  id               String   @id @default(uuid())
  name             String
  locationName     String
  lat              Float
  lng              Float
  openingHours     String
  priceRange       String // ₹ | ₹₹ | ₹₹₹
  rating           Float    @default(4.2)
  imageUrl         String?
  phone            String?
  isVegetarianOnly Boolean  @default(false)
  description      String?
  createdAt        DateTime @default(now())

  foodItems FoodItem[]
}

model FoodItem {
  id           String   @id @default(uuid())
  cafeteriaId  String
  name         String
  category     String // MEALS | SNACKS | BEVERAGES | DESSERTS | BREAKFAST
  price        Float
  isVeg        Boolean  @default(true)
  isVegan      Boolean  @default(false)
  isHealthy    Boolean  @default(false)
  calories     Int?
  popularScore Float    @default(4.0)
  description  String?
  imageUrl     String?
  createdAt    DateTime @default(now())

  cafeteria Cafeteria @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
}

model RoommateProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  preferredHostel   String // Ganga Hostel | Kaveri Hostel | Yamuna Hostel | Brahmaputra
  roomType          String // SINGLE | DOUBLE | TRIPLE
  sleepSchedule     String // EARLY_BIRD | NIGHT_OWL | FLEXIBLE
  studyHabits       String // SILENT_SOLO | GROUP_STUDY | BALANCED
  cleanliness       String // METICULOUS | MODERATE | RELAXED
  foodPreference    String // VEGETARIAN | NON_VEGETARIAN | JAIN | VEGAN | ANY
  noiseTolerance    String // LOW | MEDIUM | HIGH
  smokingPreference String // NON_SMOKER | SMOKER | OUTSIDE_ONLY
  pets              String // NO_PETS | PET_FRIENDLY
  socialPreference  String // INTROVERT | EXTROVERT | AMBIVERT
  budget            Int // Monthly budget range (e.g. 5000, 8000, 12000)
  department        String
  year              Int
  bio               String
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoommateConnection {
  id                 String   @id @default(uuid())
  requesterId        String
  targetId           String
  status             String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  compatibilityScore Int // 0 - 100
  message            String?
  createdAt          DateTime @default(now())

  requester User @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("ReceivedConnections", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String // MATCH | EVENT | ROOMMATE | ALERT | ANNOUNCEMENT
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  sender         String // USER | ASSISTANT
  content        String
  intent         String? // Intent classification
  structuredData String? // JSON string containing rich cards/recommendations
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  category  String // ACADEMICS | TIMINGS | EMERGENCY | HOSTEL | TRANSPORT | RULES | FACILITIES
  content   String
  keywords  String // Comma separated keywords
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  category  String // UI | AI_ACCURACY | NAVIGATION | FOOD | OTHER
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
