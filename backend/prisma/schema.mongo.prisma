generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  name         String
  studentId    String?
  role         String    @default("STUDENT")
  department   String?
  year         Int?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  eventsOrganized      Event[]               @relation("EventOrganizer")
  rsvps                EventRsvp[]
  lostItems            LostItem[]
  foundItems           FoundItem[]
  roommateProfile      RoommateProfile?
  sentConnections      RoommateConnection[]  @relation("SentConnections")
  receivedConnections  RoommateConnection[]  @relation("ReceivedConnections")
  notifications        Notification[]
  aiConversations      AiConversation[]
  feedbacks            Feedback[]
}

model CampusLocation {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  code         String    @unique
  category     String
  lat          Float
  lng          Float
  floor        String?
  description  String
  openingHours String
  isAccessible Boolean   @default(true)
  amenities    String?
  buildingId   String?
  imageUrl     String?
  createdAt    DateTime  @default(now())

  events       Event[]
}

model Building {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String   @unique
  lat         Float
  lng         Float
  floors      Int      @default(3)
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Facility {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String
  buildingName String
  roomNumber   String
  floor        String
  description  String
  openingHours String
  isAccessible Boolean  @default(true)
  lat          Float
  lng          Float
  createdAt    DateTime @default(now())
}

model Event {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  category        String
  date            String
  startTime       String
  endTime         String
  locationName    String
  locationId      String?     @db.ObjectId
  organizerName   String
  organizerId     String?     @db.ObjectId
  imageUrl        String?
  maxParticipants Int         @default(100)
  isFree          Boolean     @default(true)
  registrationLink String?
  createdAt       DateTime    @default(now())

  location        CampusLocation? @relation(fields: [locationId], references: [id])
  organizer       User?           @relation("EventOrganizer", fields: [organizerId], references: [id])
  rsvps           EventRsvp[]
}

model EventRsvp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  userId    String   @db.ObjectId
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model LostItem {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  userId            String      @db.ObjectId
  title             String
  category          String
  description       String
  color             String
  lostDate          String
  locationName      String
  imageUrl          String?
  contactPreference String      @default("IN_APP")
  status            String      @default("ACTIVE")
  createdAt         DateTime    @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches           ItemMatch[] @relation("LostItemMatches")
}

model FoundItem {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  title         String
  category      String
  description   String
  color         String
  foundDate     String
  locationName  String
  imageUrl      String?
  contactMethod String      @default("CAMPUS_SECURITY_DESK")
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches       ItemMatch[] @relation("FoundItemMatches")
}

model ItemMatch {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  lostItemId      String    @db.ObjectId
  foundItemId     String    @db.ObjectId
  confidenceScore Int
  matchReason     String
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())

  lostItem        LostItem  @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem       FoundItem @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)
}

model Cafeteria {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  locationName     String
  lat              Float
  lng              Float
  openingHours     String
  priceRange       String
  rating           Float      @default(4.2)
  imageUrl         String?
  phone            String?
  isVegetarianOnly Boolean    @default(false)
  description      String?
  createdAt        DateTime   @default(now())

  foodItems        FoodItem[]
}

model FoodItem {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeteriaId  String    @db.ObjectId
  name         String
  category     String
  price        Float
  isVeg        Boolean   @default(true)
  isVegan      Boolean   @default(false)
  isHealthy    Boolean   @default(false)
  calories     Int?
  popularScore Float     @default(4.0)
  description  String?
  imageUrl     String?
  createdAt    DateTime  @default(now())

  cafeteria    Cafeteria @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
}

model RoommateProfile {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  preferredHostel   String
  roomType          String
  sleepSchedule     String
  studyHabits       String
  cleanliness       String
  foodPreference    String
  noiseTolerance    String
  smokingPreference String
  pets              String
  socialPreference  String
  budget            Int
  department        String
  year              Int
  bio               String
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoommateConnection {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId        String   @db.ObjectId
  targetId           String   @db.ObjectId
  status             String   @default("PENDING")
  compatibilityScore Int
  message            String?
  createdAt          DateTime @default(now())

  requester          User     @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  target             User     @relation("ReceivedConnections", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String         @db.ObjectId
  sender         String
  content        String
  intent         String?
  structuredData String?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String
  content   String
  keywords  String
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  category  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
