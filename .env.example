# CampusAI Platform Environment Configuration

# Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL for Docker, SQLite for instant zero-dependency local dev)
# Local SQLite: file:./campusai.db
# Production PostgreSQL: postgresql://campusai_user:campusai_secure_password_2026@localhost:5432/campusai_db?schema=public
DATABASE_URL="file:./campusai.db"

# Security & Authentication
JWT_SECRET="campusai_super_secret_jwt_key_2026_production_grade"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# IBM watsonx / IBM Bob AI Integration
# Leave empty to automatically use the built-in intelligent Heuristic NLP provider (offline-ready)
IBM_API_KEY=""
IBM_PROJECT_ID=""
IBM_URL="https://us-south.ml.cloud.ibm.com"

# Optional Map Provider Keys (OpenStreetMap Leaflet is default, zero API key required)
MAP_API_KEY=""
STORAGE_URL=""
